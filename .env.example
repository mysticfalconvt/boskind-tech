POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Toxiproxy (pages/toxiproxyDelay + /api/toxiproxy/latency) — server-side only
TOXIPROXY_API=
TOXIPROXY_PASSWORD=
# TOXIPROXY_TOXIC_NAME=latency

# Homelab dashboard (/homelab). All server-side only; never exposed to the
# browser. When HOMELAB_ACCESS_KEY is unset the pages + API return 503 (feature
# fail-closed) and the nav link stays hidden.
HOMELAB_ACCESS_KEY=
HOMELAB_UNRAID_HOST=
HOMELAB_UNRAID_API_KEY=
# Coolify host MUST include the port (Coolify's API listens on 8000, not 80)
HOMELAB_COOLIFY_HOST=
HOMELAB_COOLIFY_TOKEN=
# Caddy Admin API host:port (default admin port is 2019). Must be reachable —
# bind `admin 0.0.0.0:2019` in the Caddyfile and publish the port. Unauthenticated,
# so firewall it to this app's host. Polled via node http (no Origin header).
HOMELAB_CADDY_HOST=
